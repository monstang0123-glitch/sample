{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A sneaker product available in the store",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the sneaker" },
        "brand": { "type": "string", "description": "Brand of the sneaker" },
        "price": { "type": "number", "description": "Price in Baht" },
        "description": { "type": "string", "description": "Detailed description" },
        "images": { "type": "array", "description": "List of image URLs" },
        "category": { "type": "string", "description": "Category (e.g., Running, Lifestyle)" },
        "stock": { "type": "integer", "description": "Number of items in stock" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "brand", "price", "description", "images", "category", "stock"]
    },
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["displayName", "email"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "An item in a user's shopping cart",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "quantity": { "type": "integer" },
        "price": { "type": "number" },
        "name": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["productId", "quantity", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid", "shipped", "delivered", "cancelled"] },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "total", "status", "address", "createdAt"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "Product",
      "description": "Collection of sneakers"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "users/{userId}/cart/{itemId}": {
      "schema": "CartItem",
      "description": "User's shopping cart items"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    }
  }
}
